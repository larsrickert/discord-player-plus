{
  "name": "discord-player-plus",
  "version": "2.0.5",
  "description": "Library for quickly creating discord music and sound bots using discord.js v14.",
  "keywords": [
    "bot",
    "discord",
    "discord.js",
    "music",
    "player"
  ],
  "homepage": "https://discordplayerplus.lars-rickert.de",
  "license": "MIT",
  "author": {
    "name": "Lars Rickert",
    "email": "dev@lars-rickert.de",
    "url": "https://lars-rickert.de"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/larsrickert/discord-player-plus"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --tsconfig tsconfig.app.json",
    "watch": "pnpm run build --watch src",
    "test": "vitest --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --write .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "deepmerge-ts": "^8.0.2",
    "discord-api-types": "~0.38.60",
    "isomorphic-unfetch": "^4.0.2",
    "libsodium-wrappers": "~0.8.4",
    "music-metadata": "^12.8.1",
    "play-dl": "^1.9.7",
    "spotify-url-info": "^3.3.3",
    "tiny-typed-emitter": "^2.1.0"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "^5.1.1",
    "vitest-mock-extended": "^6.0.1"
  },
  "peerDependencies": {
    "@discordjs/opus": ">= 0.11.0",
    "@discordjs/voice": ">= 0.19.0",
    "discord.js": ">= 14.28.0",
    "ffmpeg-static": ">= 5.3.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
